{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Macro-Peak Unified Peak Intelligence Model v1.4",
  "type": "object",
  "required": ["schema_version", "snapshot", "eligibility", "weekly", "model", "sources"],
  "properties": {
    "schema_version": {"const": "1.4.0"},
    "snapshot": {
      "type": "object",
      "required": ["snapshot_id", "decision_cutoff_at", "week", "data_tier", "universe_id", "manifest"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision_cutoff_at": {"type": "string", "format": "date-time"},
        "week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
        "manifest": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "last", "source_id"],
        "properties": {
          "status": {"enum": ["available_verified","available_reconstructed","insufficient_history","missing_source","stale","not_computed","not_approved","not_applicable"]},
          "last": {"type": ["object","null"]},
          "source_id": {"type": "string"}
        }
      }
    },
    "weekly": {
      "type": "object",
      "required": ["comparison", "changes"],
      "properties": {
        "comparison": {"enum": ["comparable","no_comparable_prior"]},
        "changes": {"type": "array", "items": {"type": "object", "required": ["change_type","asset_id","peak_event_id","decision_as_of"]}}
      }
    },
    "model": {"type": "object", "required": ["state","version","approved_scopes","validation"]},
    "sources": {"type": "object"}
  },
  "$defs": {
    "asset_chunk": {
      "type": "object",
      "required": ["schema_version","snapshot_id","asset_id","queries","analog_catalog"],
      "properties": {"schema_version": {"const": "1.4.0"}}
    }
  }
}
